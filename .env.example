# --- Supabase (public: used by the browser for Auth only) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server only) ---
SUPABASE_SERVICE_ROLE_KEY=
# Local: direct connection. Production: Supavisor transaction pooler (port 6543) + ?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
# Used only by drizzle-kit migrations (direct connection, port 5432 in production)
DATABASE_URL_MIGRATIONS=postgresql://postgres:postgres@127.0.0.1:55322/postgres

# --- App ---
SUPER_ADMIN_EMAIL=admin@example.com
APP_URL=http://localhost:3000
THERAPIST_CAN_CANCEL_OCCURRENCE=true

# --- Email (M3): Gmail SMTP with an App Password ---
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM="Rooms <you@gmail.com>"

# --- Cron (M3) ---
CRON_SECRET=

# --- Monitoring ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
